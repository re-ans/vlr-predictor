# ---------------------------------------------------------------------------
# VLR Predictor environment variables
# Copy this file to .env and fill in real values. NEVER commit .env.
# ---------------------------------------------------------------------------

# --- PandaScore (source of truth for schedules/results) ---------------------
# Free-tier API token from https://pandascore.co dashboard.
PANDASCORE_TOKEN=your_pandascore_token_here
PANDASCORE_BASE_URL=https://api.pandascore.co

# --- vlrggapi (self-hosted fork, enrichment data) --------------------------
# Local instance only. Do NOT point this at a cloud deployment (vlr.gg blocks
# datacenter IPs) and do NOT use the public vlrggapi.vercel.app (it is down).
VLRGGAPI_BASE_URL=http://127.0.0.1:3001

# --- Postgres (cloud-hosted: Neon / Supabase) ------------------------------
# Full connection string, e.g.
#   postgresql://user:pass@host/dbname?sslmode=require
# On your home machine, set this so the local sync script can write directly
# to the cloud DB (outbound only, never exposed).
DATABASE_URL=postgresql://user:password@host:5432/vlrpredictor?sslmode=require

# --- Redis (cache for hot endpoints) ---------------------------------------
REDIS_URL=redis://localhost:6379/0

# --- Auth (user profiles) --------------------------------------------------
# Secret used to sign JWT session tokens. Generate a strong random value in
# production, e.g. `python -c "import secrets; print(secrets.token_hex(32))"`.
JWT_SECRET=dev-insecure-change-me
# Token lifetime in minutes (default 7 days).
JWT_EXPIRE_MINUTES=10080

# --- Frontend (CORS / Vercel) ------------------------------------------------
# The URL of the deployed frontend, e.g. https://vlr-predictor.vercel.app
# The backend allows this origin for cross-origin requests.
FRONTEND_URL=

# --- Ingestion scope --------------------------------------------------------
# Comma-separated PandaScore/vlr region focus. Empty = ingest everything.
INGEST_REGIONS=
